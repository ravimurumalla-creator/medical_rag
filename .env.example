APP_NAME=Medical Document Intelligence API
APP_VERSION=0.1.0
ENVIRONMENT=dev
ENABLE_DOCS=true

API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

S3_BUCKET_NAME=medical-doc-intelligence-dev
S3_RAW_PREFIX=raw/
S3_EXTRACTED_PREFIX=extracted/
S3_PAGES_PREFIX=pages/

BEDROCK_MODEL_ID = "amazon.nova-micro-v1:0"
BEDROCK_MAX_TOKENS=512
BEDROCK_TEMPERATURE=0.0

DATA_DIR=data
OUTPUT_DIR=output
LOG_LEVEL=INFO
USE_MOCK_AWS=false